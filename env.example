# Server Configuration
PORT=3000

# Email Configuration (optional - set EMAIL_ENABLED=false to disable)
EMAIL_ENABLED=false

# SMTP Configuration (required if EMAIL_ENABLED=true)
# Beispiel für Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ihre-email@gmail.com
# SMTP_PASS=ihr-app-passwort

# Beispiel für andere SMTP-Server:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ihre-email@example.com
# SMTP_PASS=ihr-passwort

# Email recipient (where form submissions will be sent)
RECIPIENT_EMAIL=info@igs-simex.de
